[Unit]
Description=FCC ULS Explorer ingestor (APScheduler FCC poller)
After=fcculs-migrate.service
Requires=fcculs-migrate.service

[Container]
Image=%INGESTOR_IMAGE%
ContainerName=ingestor
Network=fcculs.network
Environment=FCCULS_DATABASE_URL=postgresql://%POSTGRES_USER%:%POSTGRES_PASSWORD%@postgres:5432/%POSTGRES_DB%
Environment=FCCULS_INGEST_POLL_MINUTES=%INGEST_POLL_MINUTES%
Environment=FCCULS_INGEST_FULL_SWEEP_MINUTES=%INGEST_FULL_SWEEP_MINUTES%
# Default CMD in the ingestor Dockerfile runs `python scheduler.py`, which
# polls FCC's download directory on the interval above and ingests anything
# not yet loaded. It replaced a once-daily cron: FCC's publication times are
# irregular enough that a single fixed run time meant a late file waited
# until the NEXT day. For the first-time full data load use
# fcculs-bootstrap.service instead (see README's Quadlet section).

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
