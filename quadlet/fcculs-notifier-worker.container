[Unit]
Description=FCC ULS Explorer notifier worker (RQ)
After=fcculs-migrate.service fcculs-redis.service
# Requires=migrate preserves Compose's service_completed_successfully
# gating; redis is Wants-only so restarting redis does not cascade-stop
# this unit (Restart=always + the app's own reconnect handles the blip).
Requires=fcculs-migrate.service
Wants=fcculs-redis.service

[Container]
Image=%NOTIFIER_IMAGE%
ContainerName=fcculs-notifier-worker
Network=fcculs.network
Environment=FCCULS_DATABASE_URL=postgresql://%POSTGRES_USER%:%POSTGRES_PASSWORD%@postgres:5432/%POSTGRES_DB%
Environment=FCCULS_REDIS_URL=redis://redis:6379/0
Environment=FCCULS_QUEUE_NAME=%QUEUE_NAME%
Environment=FCCULS_SMTP_HOST=%SMTP_HOST%
Environment=FCCULS_SMTP_PORT=%SMTP_PORT%
Environment=FCCULS_SMTP_USER=%SMTP_USER%
Environment=FCCULS_SMTP_PASSWORD=%SMTP_PASSWORD%
Environment=FCCULS_SMTP_USE_TLS=%SMTP_USE_TLS%
Environment=FCCULS_SMTP_FROM_ADDRESS=%SMTP_FROM_ADDRESS%
Environment=FCCULS_MAX_DELIVERY_ATTEMPTS=%MAX_DELIVERY_ATTEMPTS%
# Default CMD in the notifier Dockerfile: python -m app.worker

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
