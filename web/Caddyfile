:8080 {
	encode gzip

	# Defense-in-depth response headers for internet-facing exposure via
	# Cloudflare Tunnel. HSTS is safe to send even over the plain-HTTP hop
	# from cloudflared to this container, since it only affects how the
	# browser behaves against the public hostname it connected to over TLS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# Reverse-proxy API calls to the api service (Compose network DNS name).
	handle /api/* {
		reverse_proxy api:8000
	}

	# MCP server. Both /mcp and /mcp/* must be matched: the SDK mounts the
	# transport at /mcp and issues its own /mcp -> /mcp/ redirect, so a
	# /mcp/* -only rule would 404 the very first request a client makes.
	handle /mcp* {
		reverse_proxy mcp:8080 {
			# MCP clients refuse to follow a redirect that downgrades to
			# http://, so the upstream must see the real scheme to build
			# its redirect correctly.
			header_up X-Forwarded-Proto {scheme}
			# Tool calls proxy through to the API and can outlast Caddy's
			# default 100s stream timeout on a slow query.
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# Static SvelteKit SPA build; try_files falls back to index.html for any
	# route SvelteKit didn't statically prerender (client-side routing).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
