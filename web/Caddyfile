:8080 {
	encode gzip

	# Defense-in-depth response headers for internet-facing exposure via
	# Cloudflare Tunnel. HSTS is safe to send even over the plain-HTTP hop
	# from cloudflared to this container, since it only affects how the
	# browser behaves against the public hostname it connected to over TLS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# Reverse-proxy API calls to the api service (Compose network DNS name).
	handle /api/* {
		reverse_proxy api:8000
	}

	# MCP server. `handle /mcp*` (not `/mcp/*`) is required: the SDK mounts
	# the transport at /mcp and redirects /mcp/ -> /mcp, so a `/mcp/*`-only
	# rule would miss the un-slashed path that clients actually use.
	#
	# Cloudflare terminates TLS and cloudflared reaches this container over
	# plain HTTP, so Caddy's own {scheme} is "http" and Caddy does not trust
	# an incoming X-Forwarded-Proto unless the sender is a configured
	# trusted_proxy. Left alone, the upstream sees "http" and emits that
	# /mcp/ -> /mcp redirect as http://, a protocol downgrade MCP clients
	# refuse to follow. Matching on the header Cloudflare actually sends
	# re-asserts the real scheme without hardcoding cloudflared's IP, and
	# still lets a genuine plain-HTTP request on the LAN stay http.
	@mcp_https {
		path /mcp*
		header X-Forwarded-Proto https
	}
	handle @mcp_https {
		reverse_proxy mcp:8080 {
			header_up X-Forwarded-Proto https
			transport http {
				response_header_timeout 120s
			}
		}
	}
	handle /mcp* {
		reverse_proxy mcp:8080 {
			transport http {
				response_header_timeout 120s
			}
		}
	}

	# Static SvelteKit SPA build; try_files falls back to index.html for any
	# route SvelteKit didn't statically prerender (client-side routing).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
