# Shell scripts must keep LF endings even in a Windows working tree.
# These are copied to / executed on Linux hosts directly (deploy scripts,
# test runners), and CRLF makes bash fail with confusing "$'\r': command
# not found" errors on every line.
*.sh text eol=lf

# Same reasoning: these are consumed by Linux tooling, not Windows editors.
Dockerfile text eol=lf
*.container text eol=lf
Caddyfile text eol=lf
