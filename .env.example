# Copy this file to `.env` (same directory as compose.yaml) and fill in
# real values before running `podman compose up -d`. Do not commit `.env`.

# --- Postgres ---
POSTGRES_USER=fcculs
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fcculs

# --- API / auth ---
# Random signing key for session cookies -- generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-random-string
# Public URL users will access the web UI at (used to build magic-link
# emails). By default this is IGNORED for that purpose: the API derives the
# actual public base URL from each request's Host/X-Forwarded-* headers
# (as forwarded by Caddy and passed through unmodified by a reverse proxy
# or Cloudflare Tunnel), so magic-link emails always use whatever hostname
# the browser actually used -- even if it's a tunnel domain you never
# type into this file. PUBLIC_BASE_URL is only used as a fallback if a
# request somehow has no Host header, or if you set
# FCCULS_TRUST_REQUEST_HOST=false below to force a fixed value (e.g. your
# proxy doesn't forward Host/X-Forwarded-Proto reliably).
PUBLIC_BASE_URL=http://localhost:8080
# Set to false to always use PUBLIC_BASE_URL above instead of deriving the
# base URL from request headers. Leave at the default (true/unset) for
# normal single-host deployments, including behind a Cloudflare Tunnel.
TRUST_REQUEST_HOST=true
PUBLISHED_PORT=8080

# Comma-separated list of origins allowed to make credentialed (cookie-
# carrying) cross-origin requests to the API. This MUST be the public
# hostname(s) users actually reach the app at (e.g. your Cloudflare Tunnel
# domain) -- never a wildcard, since browsers respond to a wildcard +
# credentials combo by allowing ANY site to ride a signed-in user's (or
# admin's) session cookie. Safe to change any time; just edit this and
# restart the api service/container (`podman compose restart api` or
# `systemctl --user restart fcculs-api` under Quadlets) -- no rebuild
# needed. Multiple origins: CORS_ALLOW_ORIGINS=https://a.example,https://b.example
CORS_ALLOW_ORIGINS=https://fcculs-explorer.n00tz.net

# Per-client-IP rate limit applied to the unauthenticated read endpoints
# (/api/search, /api/amateur browse, /api/towers browse) -- these run
# trigram/filter queries against multi-million-row tables and are the
# easiest DoS/cost-abuse surface once the app is reachable from the
# internet. 60/minute comfortably covers real interactive browsing while
# bounding a scripted scraper. Safe to change any time; just edit this and
# restart the api service/container -- no rebuild needed.
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60

# --- SMTP relay (BYO -- any relay that accepts authenticated or open
# relay-from-localnet SMTP works: Postfix, msmtp relay, a mail provider's
# SMTP-relay product, etc.) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@fcculs-explorer.example

# --- Ingestor schedule ---
# The ingestor POLLS FCC's download directory rather than running once a day.
# FCC's publication times are irregular (tower lands around 05:00 UTC,
# amateur/GMRS around 12:00 UTC, and files have been observed anywhere in
# between), so a single fixed daily run meant a file published even slightly
# late waited until the NEXT day -- roughly 24 hours. Polling bounds that at
# one interval.
#
# Each poll reads FCC's directory listing in ONE conditional request, which
# is usually a 304 with no body, and only checks individual files when a day
# is actually outstanding. Lowering this is therefore cheap, but be a good
# citizen: this is a government server, and the daily files only change once
# a day anyway.
INGEST_POLL_MINUTES=15
# How often to re-check every file directly instead of trusting the "nothing
# changed" fast path. Covers FCC re-publishing an older weekday file without
# the (statically generated) directory listing reflecting it yet.
INGEST_FULL_SWEEP_MINUTES=60
#
# MIGRATION NOTE: INGEST_CRON_HOUR / INGEST_CRON_MINUTE were removed when the
# daily cron was replaced by polling. Leaving them in an existing .env is
# harmless -- they are simply ignored -- but they no longer do anything.

# --- Notifier ---
MAX_DELIVERY_ATTEMPTS=5
# How often (seconds) the dispatcher checks for new change_events to match
# against active watches.
DISPATCH_INTERVAL_SECONDS=60
# Redis/RQ queue name shared by the api (enqueues "test send" jobs) and the
# notifier (enqueues + consumes real delivery jobs). Both services must
# agree on this value -- only change it if you have a reason to (e.g.
# running more than one FCC ULS Explorer stack against the same Redis).
QUEUE_NAME=fcculs-notifications

# --- MCP server (read-only tools for MCP-capable clients/agents) ---
# Exposed at <PUBLIC_BASE_URL>/mcp. This surface is read-only and
# unauthenticated by design: it can only reach the same public browse,
# search and detail data the REST API already serves anonymously. It
# cannot create watches, manage notification channels, or touch the admin
# panel. Remove the /mcp route from web/Caddyfile if you would rather not
# publish it at all.
#
# Tool results are consumed by LLMs with finite context windows, so these
# default lower than the REST API's own page sizes. Raise them only if
# your client handles large results well.
MCP_DEFAULT_PAGE_SIZE=10
MCP_MAX_PAGE_SIZE=50

# --- Backups (deploy/backup.sh, deploy/restore.sh, fcculs-backup.timer) ---
# Where daily pg_dump backups are written on the HOST (not inside a
# container) -- users/watches/notification_channels live only in this
# database and are not re-derivable from the FCC data files, unlike the
# ingested amateur/tower tables. Can also be overridden per-invocation with
# the FCCULS_BACKUP_DIR environment variable (takes precedence over this).
BACKUP_DIR=~/fcculs-backups
# Backups older than this many days are deleted every time backup.sh runs.
# Can also be overridden with FCCULS_BACKUP_RETENTION_DAYS.
BACKUP_RETENTION_DAYS=3

