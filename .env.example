# Copy this file to `.env` (same directory as compose.yaml) and fill in
# real values before running `podman compose up -d`. Do not commit `.env`.

# --- Postgres ---
POSTGRES_USER=fcculs
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fcculs

# --- API / auth ---
# Random signing key for session cookies -- generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-random-string
# Public URL users will access the web UI at (used to build magic-link
# emails). By default this is IGNORED for that purpose: the API derives the
# actual public base URL from each request's Host/X-Forwarded-* headers
# (as forwarded by Caddy and passed through unmodified by a reverse proxy
# or Cloudflare Tunnel), so magic-link emails always use whatever hostname
# the browser actually used -- even if it's a tunnel domain you never
# type into this file. PUBLIC_BASE_URL is only used as a fallback if a
# request somehow has no Host header, or if you set
# FCCULS_TRUST_REQUEST_HOST=false below to force a fixed value (e.g. your
# proxy doesn't forward Host/X-Forwarded-Proto reliably).
PUBLIC_BASE_URL=http://localhost:8080
# Set to false to always use PUBLIC_BASE_URL above instead of deriving the
# base URL from request headers. Leave at the default (true/unset) for
# normal single-host deployments, including behind a Cloudflare Tunnel.
TRUST_REQUEST_HOST=true
PUBLISHED_PORT=8080

# Comma-separated list of origins allowed to make credentialed (cookie-
# carrying) cross-origin requests to the API. This MUST be the public
# hostname(s) users actually reach the app at (e.g. your Cloudflare Tunnel
# domain) -- never a wildcard, since browsers respond to a wildcard +
# credentials combo by allowing ANY site to ride a signed-in user's (or
# admin's) session cookie. Safe to change any time; just edit this and
# restart the api service/container (`podman compose restart api` or
# `systemctl --user restart fcculs-api` under Quadlets) -- no rebuild
# needed. Multiple origins: CORS_ALLOW_ORIGINS=https://a.example,https://b.example
CORS_ALLOW_ORIGINS=https://fcculs-explorer.n00tz.net

# --- SMTP relay (BYO -- any relay that accepts authenticated or open
# relay-from-localnet SMTP works: Postfix, msmtp relay, a mail provider's
# SMTP-relay product, etc.) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@fcculs-explorer.example

# --- Ingestor schedule (24h UTC) ---
INGEST_CRON_HOUR=7
INGEST_CRON_MINUTE=0

# --- Notifier ---
MAX_DELIVERY_ATTEMPTS=5
# How often (seconds) the dispatcher checks for new change_events to match
# against active watches.
DISPATCH_INTERVAL_SECONDS=60
